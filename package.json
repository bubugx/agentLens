{
  "name": "agentlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "check": "vue-tsc -b && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "probe": "cargo run --manifest-path src-tauri/Cargo.toml --bin agentlens-probe --",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.5"
  }
}
